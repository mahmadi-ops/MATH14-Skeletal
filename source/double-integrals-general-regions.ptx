<annotations>
<annotation ref="figure" text="A region between two curves for y between zero point one and zero point five. The left boundary, drawn in vermillion, is g 1 of y equals y squared. The right boundary, drawn in blue, is g 2 of y equals the cube root of y. The region between them is shaded light green with three horizontal green strips, and dashed lines mark y equals zero point one and y equals zero point five.">
  <annotation ref="c2-g1" text="The left boundary g 1 of y equals y squared, drawn in vermillion."/>
  <annotation ref="c2-g2" text="The right boundary g 2 of y equals y to the one third, drawn in blue."/>
  <annotation ref="c2-region" text="The region R, shaded in light green."/>
