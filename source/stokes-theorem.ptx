\draw[gray!35] (0,3.5) -- (15,3.5);
\node[anchor=north west, font=\small\itshape] at (0.35,8.7) {$\mathbf i$-component: \qquad $\mathbf j$-component: \qquad $\mathbf k$-component:};
\node[anchor=north west, font=\small\itshape] at (0.35,3.2) {$\nabla\times\mathbf F =$ \qquad at $P(1,1,1)$:};
\end{tikzpicture}
</latex-image>
<shortdescription>Blank box in two rows, one for the three components of the curl and one for the curl and its value at the point P.</shortdescription>
</image>
</sidebyside>
</statement>
</example>

