              opacity=0.75, fill opacity=0.75,
              domain=0:1, samples=14, y domain=0:360, samples y=40,
              forget plot]
      ({x*cos(y)}, {x*sin(y)}, {2 - x*sin(y)});
    % ---- the curve C ----
