              domain=0:360, forget plot]
      ({cos(x)}, {sin(x)}, {2 - sin(x)});
    % arrowheads written out, as in fig-stokes-orientation-tikz
    \draw[-{Latex[length=2.6mm]}, oivermillion, line width=1.5pt]
      (axis cs:0.9135,0.4067,1.5933) -- (axis cs:0.8090,0.5878,1.4122);
    \draw[-{Latex[length=2.6mm]}, oivermillion, line width=1.5pt]
      (axis cs:-0.8090,0.5878,1.4122) -- (axis cs:-0.9135,0.4067,1.5933);
    \draw[-{Latex[length=2.6mm]}, oivermillion, line width=1.5pt]
      (axis cs:-0.1045,-0.9945,2.9945) -- (axis cs:0.1045,-0.9945,2.9945);
    % ---- labels ----
    \node[oivermillion, font=\large] at (axis cs:1.16,0.95,2.35) {$C$};
    \node[oiblue, font=\large] at (axis cs:0,0,2.35) {$S$};
    \node[font=\large, anchor=north] at (axis cs:0.15,0.95,-0.12) {$R$};
    \node[font=\large, anchor=north west] at (axis description cs:0.0,0.99)
      {$y + z = 2$};
  \end{axis}
\end{tikzpicture}]]>
</latex-image>
</image>
</figure>

<!-- The next four examples are variations on the worked examples of    -->
<!-- CLP-4 Vector Calculus, Section 4.4 (Feldman, Rechnitzer, Yeager),  -->
<!-- with different fields, curves, and numbers.                        -->

<p>
The next example shows the theorem at its most merciless: one term of
the field cannot be integrated in closed form at all, and Stokes'
theorem simply erases it.
</p>

<example xml:id="example-stokes-flat-disk">
<title>A Term That Cannot Be Integrated</title>
<statement>
<p>
Evaluate <m>\oint_C \mathbf{F} \cdot d\mathbf{r}</m> for
<me>
\mathbf{F} = \left[\cos\left(x^{100}\right) + 3y\right]\mathbf{i}
+ 4z\,\mathbf{j} + 2y\,\mathbf{k},
</me>
where <m>C</m> is the circle <m>x^2 + y^2 = 9</m>, <m>z = 2</m>,
traversed counterclockwise when seen from above.
</p>
<p>
<em>Solution.</em>
(The term <m>\cos(x^{100})</m> makes a direct evaluation hopeless, but
Stokes' theorem only ever sees the field through its curl: compute it
by <xref ref="eq-curl-3d"/> and watch the monster disappear. Take the
cheapest surface with boundary <m>C</m>, the flat disk of
<xref ref="fig-stokes-flat-disk-tikz"/>; which unit normal does the
right-hand rule pair with the counterclockwise orientation? The
integrand is then a constant.)
</p>

<sidebyside width="97%">
<image>
<latex-image>
\begin{tikzpicture}
\draw[rounded corners=8pt, draw=gray!55, thick] (0,0) rectangle (15,10);
\draw[gray!35] (0,6.5) -- (15,6.5);
\draw[gray!35] (0,3.5) -- (15,3.5);
\node[anchor=north west, font=\small\itshape] at (0.35,9.7) {$\nabla\times\mathbf F =$};
\node[anchor=north west, font=\small\itshape] at (0.35,6.2) {$S =$ \qquad $\hat{\mathbf n} =$ \qquad $(\nabla\times\mathbf F)\cdot\hat{\mathbf n} =$};
\node[anchor=north west, font=\small\itshape] at (0.35,3.2) {$\displaystyle\oint_C \mathbf F\cdot d\mathbf r =$};
\end{tikzpicture}
</latex-image>
<shortdescription>Blank box in three rows, for the curl, for the flat surface with its normal and the integrand, and for the circulation.</shortdescription>
</image>
</sidebyside>
</statement>
</example>

<figure xml:id="fig-stokes-flat-disk-tikz">
<caption>
The cheapest surface for <xref ref="example-stokes-flat-disk"/>: the
flat disk <m>S</m> of radius <m>3</m> in the plane <m>z=2</m>, whose
boundary is the given circle <m>C</m>.
</caption>
<image xml:id="image-stokes-flat-disk" width="62%">
<shortdescription>
A flat disk floating at height two, with its boundary circle and an upward normal.
</shortdescription>
<description>
<p>
A translucent blue disk of radius three lies in the horizontal plane at
height two above the origin. Its boundary circle is drawn in vermillion with
arrowheads pointing counterclockwise seen from above, and a green arrow
labelled n hat equals k rises from the centre of the disk.
</p>
</description>
<latex-image>
<![CDATA[\begin{tikzpicture}[line join=round, line cap=round]
  \definecolor{oiblue}{RGB}{0,114,178}
  \definecolor{oivermillion}{RGB}{213,94,0}
  \definecolor{oigreen}{RGB}{0,158,115}
  \begin{axis}[
      view={118}{18}, width=11cm, axis lines=center,
      axis line style={-latex, black!70, line width=0.7pt},
      xlabel={$x$}, ylabel={$y$}, zlabel={$z$},
      label style={font=\large}, ticks=none,
      xmin=-4, xmax=4, ymin=-4, ymax=4, zmin=0, zmax=3.6,
      clip=false,
    ]
    % the flat disk S at height 2
    \addplot3[surf, shader=flat, draw=oiblue!45, fill=oiblue!22,
              opacity=0.72, fill opacity=0.72,
              domain=0:3, samples=14, y domain=0:360, samples y=44,
              forget plot]
      ({x*cos(y)}, {x*sin(y)}, 2);
    % its boundary C
    \addplot3[oivermillion, line width=1.5pt, samples=120, samples y=0,
              domain=0:360, forget plot]
      ({3*cos(x)}, {3*sin(x)}, 2);
    \draw[-{Latex[length=2.6mm]}, oivermillion, line width=1.5pt]
      (axis cs:2.984,-0.314,2) -- (axis cs:2.984,0.314,2);
    \draw[-{Latex[length=2.6mm]}, oivermillion, line width=1.5pt]
      (axis cs:-1.124,2.782,2) -- (axis cs:-1.634,2.516,2);
    \draw[-{Latex[length=2.6mm]}, oivermillion, line width=1.5pt]
      (axis cs:-1.315,-2.696,2) -- (axis cs:-0.726,-2.911,2);
    % the normal
    \draw[-{Latex[length=3mm]}, oigreen, line width=1.4pt]
      (axis cs:0,0,2) -- (axis cs:0,0,3.05);
    \node[oigreen, font=\large, anchor=west]
      at (axis cs:0.14,0,2.90) {$\hat{\mathbf{n}} = \mathbf{k}$};
    \node[oiblue, font=\large] at (axis cs:-2.1,1.6,2.0) {$S$};
    \node[oivermillion, font=\large] at (axis cs:3.35,1.5,2.0) {$C$};
    \draw[black!45, dashed, line width=0.7pt]
      (axis cs:3,0,0) -- (axis cs:3,0,2);
    \node[anchor=north, font=\small] at (axis cs:3,0,-0.08) {$3$};
    \draw[black!55, line width=0.6pt] (axis cs:0,0,2) -- (axis cs:0.14,0,2);
    \node[anchor=east, font=\small] at (axis cs:0,0,2) {$2$};
  \end{axis}
\end{tikzpicture}]]>
</latex-image>
</image>
</figure>

<p>
The same trick works when the curve is tilted<mdash/>the flat surface it
bounds just tilts with it.
</p>

<example xml:id="example-stokes-tilted-circle">
<title>A Tilted Circle</title>
<statement>
<p>
Evaluate <m>\oint_C \mathbf{F} \cdot d\mathbf{r}</m> for
<me>
\mathbf{F} = \ln\left(1 + x^8\right)\mathbf{i} - z\,\mathbf{j}
+ y\,\mathbf{k},
</me>
where <m>C</m> is the intersection of the sphere
<m>x^2 + y^2 + z^2 = 9</m> with the plane <m>z = x</m>, traversed
counterclockwise when seen from above.
</p>
<p>
<em>Solution.</em>
(Where is the centre of the sphere relative to the plane, and so what
kind of circle is <m>C</m>, with what radius? The
<m>\ln(1+x^8)</m> again rules out a direct attack and again dies under
the curl. Take <m>S</m> to be the flat disk that <m>C</m> bounds in the
plane <m>z = x</m>, shown in <xref ref="fig-stokes-tilted-tikz"/>; a
normal to the plane is the gradient of <m>z - x</m>, and the right-hand
rule picks the upward one. The integrand is constant, so the flux is
that constant times the area of the disk. As a check, redo it with the
graph protocol <m>\hat{\mathbf n}\,d\sigma = \langle -f_x, -f_y, 1\rangle\,dx\,dy</m>
over the shadow of <m>S</m>, which is an ellipse.)
</p>

<sidebyside width="97%">
<image>
<latex-image>
\begin{tikzpicture}
\draw[rounded corners=8pt, draw=gray!55, thick] (0,0) rectangle (15,13);
\draw[gray!35] (0,10.5) -- (15,10.5);
\draw[gray!35] (0,7.5) -- (15,7.5);
\draw[gray!35] (0,4) -- (15,4);
\node[anchor=north west, font=\small\itshape] at (0.35,12.7) {$C$ is \qquad radius \qquad $\nabla\times\mathbf F =$};
\node[anchor=north west, font=\small\itshape] at (0.35,10.2) {$\hat{\mathbf n} =$ \qquad $(\nabla\times\mathbf F)\cdot\hat{\mathbf n} =$};
\node[anchor=north west, font=\small\itshape] at (0.35,7.2) {$\displaystyle\oint_C \mathbf F\cdot d\mathbf r =$};
\node[anchor=north west, font=\small\itshape] at (0.35,3.7) {check by the graph protocol: shadow $=$ \qquad $\displaystyle\iint$};
\end{tikzpicture}
</latex-image>
<shortdescription>Blank box in four rows, for the description of the curve and the curl, for the unit normal and the integrand, for the circulation, and for the check by the graph protocol.</shortdescription>
</image>
</sidebyside>
</statement>
</example>

<figure xml:id="fig-stokes-tilted-tikz">
<caption>
The curve of <xref ref="example-stokes-tilted-circle"/>: the plane
<m>z=x</m> cuts the sphere <m>x^2+y^2+z^2=9</m> in the circle
<m>C</m>, and the surface <m>S</m> is the flat disk that <m>C</m>
bounds in that plane, tilted at <m>45^\circ</m>.
</caption>
<image xml:id="image-stokes-tilted" width="62%">
<shortdescription>
A sphere cut by a slanted plane through its centre, with the great circle and the tilted disk it bounds.
</shortdescription>
<description>
<p>
A faint grey sphere of radius three is cut through its centre by a
slanted plane. The circle of intersection is drawn in vermillion with
arrowheads showing counterclockwise travel seen from above, the flat disk
inside it is shaded blue, and a green arrow perpendicular to that disk
points up and toward the negative x direction.
</p>
</description>
<latex-image>
<![CDATA[\begin{tikzpicture}[line join=round, line cap=round]
  \definecolor{oiblue}{RGB}{0,114,178}
  \definecolor{oivermillion}{RGB}{213,94,0}
  \definecolor{oigreen}{RGB}{0,158,115}
  \begin{axis}[
      view={118}{16}, width=11cm, axis lines=center,
      axis line style={-latex, black!70, line width=0.7pt},
      xlabel={$x$}, ylabel={$y$}, zlabel={$z$},
      label style={font=\large}, ticks=none,
      xmin=-4, xmax=4, ymin=-4, ymax=4, zmin=-3.6, zmax=3.6,
      clip=false,
    ]
    % the sphere of radius 3
    \addplot3[surf, shader=faceted, faceted color=black!12,
              colormap={sph}{color=(black!6!white) color=(black!16!white)},
              opacity=0.22, fill opacity=0.22,
              domain=0:360, samples=40, y domain=0:180, samples y=24,
              z buffer=sort, forget plot]
      ({3*cos(x)*sin(y)}, {3*sin(x)*sin(y)}, {3*cos(y)});
    % the disk S cut out by the plane z = x, spanned by (1,0,1)/sqrt2 and (0,1,0)
    \addplot3[surf, shader=flat, draw=oiblue!45, fill=oiblue!24,
              opacity=0.7, fill opacity=0.7,
              domain=0:3, samples=14, y domain=0:360, samples y=44,
              forget plot]
      ({x*cos(y)*0.7071}, {x*sin(y)}, {x*cos(y)*0.7071});
    % the great circle C
    \addplot3[oivermillion, line width=1.5pt, samples=140, samples y=0,
              domain=0:360, forget plot]
      ({3*cos(x)*0.7071}, {3*sin(x)}, {3*cos(x)*0.7071});
    \draw[-{Latex[length=2.6mm]}, oivermillion, line width=1.5pt]
      (axis cs:2.110,-0.314,2.110) -- (axis cs:2.110,0.314,2.110);
    \draw[-{Latex[length=2.6mm]}, oivermillion, line width=1.5pt]
      (axis cs:-0.795,2.782,-0.795) -- (axis cs:-1.155,2.516,-1.155);
    % the unit normal (-i + k)/sqrt 2
    \draw[-{Latex[length=3mm]}, oigreen, line width=1.4pt]
      (axis cs:0,0,0) -- (axis cs:-1.06,0,1.06);
    \node[oigreen, font=\large, anchor=south east]
      at (axis cs:-1.08,0,1.10) {$\hat{\mathbf{n}}$};
    \node[oiblue, font=\large] at (axis cs:0.9,1.9,0.9) {$S$};
    \node[oivermillion, font=\large] at (axis cs:2.35,1.9,2.35) {$C$};
    \node[black!55, font=\large] at (axis cs:-2.2,-2.2,2.3)
      {$x^2+y^2+z^2=9$};
  \end{axis}
\end{tikzpicture}]]>
</latex-image>
</image>
</figure>

<p>
When the boundary is made of straight segments, both sides of
<xref ref="eq-stokes"/> are computable, and the comparison is
instructive: the direct route costs three parametrizations, the Stokes
route one double integral.
</p>

<example xml:id="example-stokes-triangle">
<title>Around a Triangle, Twice</title>
<statement>
<p>
Evaluate <m>\oint_C \mathbf{F} \cdot d\mathbf{r}</m> for
<me>
\mathbf{F} = (y - z)\,\mathbf{i} + (x + z)\,\mathbf{j}
+ \left(x^2 + y\right)\mathbf{k},
</me>
where <m>C</m> goes from <m>(2,0,0)</m> to <m>(0,2,0)</m> to
<m>(0,0,4)</m> and back to <m>(2,0,0)</m> along straight line segments,
as in <xref ref="fig-stokes-triangle-tikz"/>. Do the computation twice:
directly, and by Stokes' theorem.
</p>
<p>
<em>Solution.</em>
(<em>Directly</em>: parametrize each of the three segments on
<m>0 \le t \le 1</m>, compute <m>\mathbf F(\mathbf r(t))\cdot\mathbf r'(t)</m>,
integrate, and add. <em>By Stokes' theorem</em>: compute the curl by
<xref ref="eq-curl-3d"/>; the triangle lies in the plane through the
three vertices, which is the graph of some <m>z = 4 - 2x - 2y</m> over
a shadow triangle <m>R</m> in the <m>xy</m>-plane. Decide which normal
the given traversal pairs with, write
<m>\hat{\mathbf n}\,d\sigma</m> for the graph, dot with the curl, and
integrate over <m>R</m>. Compare the two answers; see
<xref ref="fig-stokes-triangle-tikz"/>.)
</p>

<sidebyside width="97%">
<image>
<latex-image>
\begin{tikzpicture}
\draw[rounded corners=8pt, draw=gray!55, thick] (0,0) rectangle (15,20);
\draw[gray!35] (0,16.5) -- (15,16.5);
\draw[gray!35] (0,13) -- (15,13);
\draw[gray!35] (0,9.5) -- (15,9.5);
\draw[gray!35] (0,7) -- (15,7);
\draw[gray!35] (0,4) -- (15,4);
\node[anchor=north west, font=\small\itshape] at (0.35,19.7) {$C_1$: $\mathbf r(t) =$ \qquad $\displaystyle\int_{C_1} \mathbf F\cdot d\mathbf r =$};
\node[anchor=north west, font=\small\itshape] at (0.35,16.2) {$C_2$: $\mathbf r(t) =$ \qquad $\displaystyle\int_{C_2} \mathbf F\cdot d\mathbf r =$};
\node[anchor=north west, font=\small\itshape] at (0.35,12.7) {$C_3$: $\mathbf r(t) =$ \qquad $\displaystyle\int_{C_3} \mathbf F\cdot d\mathbf r =$ \qquad total:};
\node[anchor=north west, font=\small\itshape] at (0.35,9.2) {$\nabla\times\mathbf F =$ \qquad the plane: $z =$ \qquad $R =$};
\node[anchor=north west, font=\small\itshape] at (0.35,6.7) {$\hat{\mathbf n}\,d\sigma =$ \qquad $(\nabla\times\mathbf F)\cdot\hat{\mathbf n}\,d\sigma =$};
\node[anchor=north west, font=\small\itshape] at (0.35,3.7) {$\displaystyle\oint_C \mathbf F\cdot d\mathbf r = \iint_R$};
\end{tikzpicture}
</latex-image>
<shortdescription>Blank box in six rows: three for the direct computation along the three segments with the total, and three for the curl with the plane and shadow, the normal and integrand, and the double integral.</shortdescription>
</image>
</sidebyside>
</statement>
</example>

<figure xml:id="fig-stokes-triangle-tikz">
<caption>
The oriented triangle of <xref ref="example-stokes-triangle"/>: from
<m>(2,0,0)</m> to <m>(0,2,0)</m> to <m>(0,0,4)</m> and back, bounding a
piece of the plane <m>\frac{x}{2} + \frac{y}{2} + \frac{z}{4} = 1</m>.
The traversal is counterclockwise seen from above, pairing with the
upward normal by the right-hand rule.
</caption>
<image xml:id="image-stokes-triangle" width="62%">
<shortdescription>
A triangle in space with vertices on the three positive coordinate
axes, its edges carrying arrowheads that circle counterclockwise seen
from above.
</shortdescription>
<description>
<p>
Coordinate axes in three dimensions. A blue triangular plate has its
corners on the positive x axis at 2, the positive y axis at 2, and the
positive z axis at 4. Vermillion arrows run along its edges from the x
axis corner to the y axis corner, then up to the z axis corner, then
back down to the x axis corner, a circuit that is counterclockwise when
seen from above.
</p>
</description>
<latex-image>
<![CDATA[\begin{tikzpicture}[line join=round, line cap=round]
  % Okabe-Ito colorblind-safe palette
  \definecolor{oiblue}{RGB}{0,114,178}
  \definecolor{oivermillion}{RGB}{213,94,0}
  \begin{axis}[
      view={120}{24},
      width=10.5cm,
      axis lines=center,
      axis line style={-latex, black!70, line width=0.7pt},
      xlabel={$x$}, ylabel={$y$}, zlabel={$z$},
      label style={font=\large},
      ticks=none,
      xmin=0, xmax=2.6, ymin=0, ymax=2.6, zmin=0, zmax=4.4,
      clip=false,
    ]
    % ---- the triangular plate ----
    \addplot3[patch, patch type=triangle, shader=flat,
              draw=oiblue!60, fill=oiblue!22, opacity=0.75,
              fill opacity=0.75, forget plot]
      coordinates {(2,0,0) (0,2,0) (0,0,4)};
    % ---- the oriented edges ----
    \draw[-{Latex[length=2.8mm]}, oivermillion, line width=1.5pt]
      (axis cs:2,0,0) -- (axis cs:1,1,0);
    \draw[oivermillion, line width=1.5pt]
      (axis cs:1,1,0) -- (axis cs:0,2,0);
    \draw[-{Latex[length=2.8mm]}, oivermillion, line width=1.5pt]
      (axis cs:0,2,0) -- (axis cs:0,1,2);
    \draw[oivermillion, line width=1.5pt]
      (axis cs:0,1,2) -- (axis cs:0,0,4);
    \draw[-{Latex[length=2.8mm]}, oivermillion, line width=1.5pt]
      (axis cs:0,0,4) -- (axis cs:1,0,2);
    \draw[oivermillion, line width=1.5pt]
      (axis cs:1,0,2) -- (axis cs:2,0,0);
    % ---- vertex labels ----
    \node[font=\small, anchor=north west] at (axis cs:2,0,0)
      {$(2,0,0)$};
    \node[font=\small, anchor=north east] at (axis cs:0,2,0)
      {$(0,2,0)$};
    \node[font=\small, anchor=south east] at (axis cs:0,0,4)
      {$(0,0,4)$};
    % ---- labels ----
    \node[oivermillion, font=\large] at (axis cs:1.15,1.15,0.45) {$C$};
    \node[oiblue, font=\large] at (axis cs:0.45,0.45,1.15) {$S$};
  \end{axis}
\end{tikzpicture}]]>
</latex-image>
</image>
</figure>

<p>
Finally, before reaching for Stokes' theorem at all, it pays to glance
at the curl: if it vanishes, no surface is needed.
</p>

<example xml:id="example-stokes-conservative">
<title>The Curve Nobody Can Parametrize</title>
<statement>
<p>
Evaluate <m>\oint_C \mathbf{F} \cdot d\mathbf{r}</m> for
<me>
\mathbf{F} = \left(e^x + y + z\right)\mathbf{i}
+ (x + z)\,\mathbf{j} + (x + y)\,\mathbf{k},
</me>
where <m>C</m> is the intersection of the ellipsoid
<m>x^2 + \frac{y^2}{4} + \frac{z^2}{9} = 1</m> with the paraboloid
<m>z = 2x^2 + y^2</m>, traversed counterclockwise when seen from above.
</p>
<p>
<em>Solution.</em>
(Parametrizing this loop, or any surface it bounds, would be
miserable. Compute the curl by <xref ref="eq-curl-3d"/> first. What
does the component test <xref ref="eq-component-test-3d"/> then say
about <m>\mathbf F</m>, and what does Stokes' theorem give for the
circulation, whichever surface the loop bounds? Can you name a
potential function?)
</p>

<sidebyside width="97%">
<image>
<latex-image>
\begin{tikzpicture}
\draw[rounded corners=8pt, draw=gray!55, thick] (0,0) rectangle (15,9);
\draw[gray!35] (0,6) -- (15,6);
\draw[gray!35] (0,3) -- (15,3);
\node[anchor=north west, font=\small\itshape] at (0.35,8.7) {$\nabla\times\mathbf F =$};
\node[anchor=north west, font=\small\itshape] at (0.35,5.7) {so $\mathbf F$ is \qquad with potential $f =$};
\node[anchor=north west, font=\small\itshape] at (0.35,2.7) {$\displaystyle\oint_C \mathbf F\cdot d\mathbf r =$};
\end{tikzpicture}
</latex-image>
<shortdescription>Blank box in three rows, for the curl, for the conclusion about the field with a potential function, and for the circulation.</shortdescription>
</image>
</sidebyside>
</statement>
</example>

<figure xml:id="fig-stokes-warped-loop-tikz">
<caption>
The curve of <xref ref="example-stokes-conservative"/>: the paraboloid
<m>z = 2x^2+y^2</m> meets the ellipsoid
<m>x^2+\frac{y^2}{4}+\frac{z^2}{9}=1</m> in a warped loop <m>C</m>.
Does anything about its shape matter?
</caption>
